# Database Connection (PostgreSQL)
# Required for data persistence.
#
# For Local Development:
# Run PostgreSQL locally or with Docker:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# For Vercel Deployment:
# Attach Vercel Postgres / Neon integration directly in the Vercel dashboard.
# Vercel will automatically set POSTGRES_URL or DATABASE_URL.
# If connecting manually (Supabase, Neon, RDS, Tembo, Railway, etc.):
# DATABASE_URL="postgresql://username:password@ep-host.region.aws.neon.tech/neondb?sslmode=require"
